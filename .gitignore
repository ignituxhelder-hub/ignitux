# Fichiers temporaires (ex. patches générés par des outils d'analyse)
*.tmp
*.temp
*_tmp.*
*.patch
# `!.git/**/*.patch` figurait ici : sans effet, git ne suit jamais son
# propre dossier. Une règle qui ne fait rien se relit comme une règle qui
# protège quelque chose, et on hésite à y toucher.

# Dossiers de travail des scripts d'analyse : jamais versionnés.
.tmp/
backend/.tmp/
frontend/.tmp/

# OS
.DS_Store
Thumbs.db

# Éditeurs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*

# Configuration de la composition Docker (voir .env.docker.example)
.env.docker
