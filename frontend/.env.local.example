NEXT_PUBLIC_API_URL="http://localhost:3000"

# Clé SITE (publique) Cloudflare Turnstile — doit correspondre à la clé
# SECRÈTE posée côté backend (TURNSTILE_SECRET_KEY, voir backend/.env.example).
# Valeur ci-dessous : la clé de test Cloudflare, qui affiche toujours un
# widget "réussi" sans compte réel. Jamais utilisable en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
