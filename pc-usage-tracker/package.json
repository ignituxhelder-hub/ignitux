{
  "name": "pc-usage-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Comptabilisation du temps d'utilisation du PC servant de serveur à IGNITUX, et calcul du montant dû à son propriétaire.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm run test -w server && npm run test -w web",
    "lint": "eslint .",
    "install-windows-service": "npm run install-service -w server",
    "uninstall-windows-service": "npm run uninstall-service -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "typescript-eslint": "^8.12.2"
  }
}
