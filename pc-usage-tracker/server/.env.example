# Port de l'API du service de comptabilisation
PORT=4100

# Tarif horaire par défaut, en euros (0,10 €/h). Modifiable ensuite depuis
# le tableau de bord (PUT /api/settings) sans redémarrer le service — les
# sessions déjà enregistrées gardent le tarif qui était en vigueur au moment
# où elles ont eu lieu.
HOURLY_RATE_EUR=0.10

# Filtre utilisé pour repérer, parmi tous les conteneurs Docker actifs sur la
# machine, ceux qui appartiennent à IGNITUX. Par défaut, le nom de projet
# Docker Compose du dépôt (dossier "ignitux") préfixe chaque conteneur :
# ignitux-backend-1, ignitux-frontend-1, ignitux-base-1... Une simple
# sous-chaîne insensible à la casse suffit donc à les repérer tous.
CONTAINER_NAME_FILTER=ignitux

# Intervalle de sondage Docker et des ressources système, en millisecondes
POLL_INTERVAL_MS=5000

# Puissance moyenne estimée de la machine sous charge, en watts — pour le
# calcul de consommation électrique (bonus). À ajuster selon le matériel.
ESTIMATED_WATTAGE=150

# Prix de l'électricité, en euros par kWh
ELECTRICITY_PRICE_PER_KWH=0.2516

# Emplacement du fichier SQLite (relatif au dossier server/ quand lancé via
# npm run dev/start depuis la racine du tracker)
DATABASE_PATH=./data/usage.db
