{
  "name": "pc-usage-tracker-server",
  "version": "1.0.0",
  "private": true,
  "description": "API et moteur de comptabilisation : détection des conteneurs Docker d'IGNITUX, historique des sessions, calcul du montant dû.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src tests",
    "install-service": "node -r tsx/cjs src/windows-service/install.ts",
    "uninstall-service": "node -r tsx/cjs src/windows-service/uninstall.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dockerode": "^4.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "node-windows": "^1.0.0-beta.8",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
