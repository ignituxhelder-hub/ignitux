# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURATION DE LA COMPOSITION DOCKER
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# `.env.docker` est ignoré par git. Ce modèle ne doit jamais contenir de
# vraie valeur.
# ═══════════════════════════════════════════════════════════════════════════

# ── Obligatoire ────────────────────────────────────────────────────────────
# 32 caractères minimum, sinon le serveur refuse de démarrer. En générer un :
#   openssl rand -base64 48
JWT_SECRET=""

# ── La base de la composition ──────────────────────────────────────────────
# Elle vit dans un volume Docker. `docker compose down -v` l'efface.
POSTGRES_USER="ignitux"
POSTGRES_PASSWORD="ignitux"
POSTGRES_DB="ignitux"
# À changer si un Postgres tourne déjà sur 5432 sur la machine.
POSTGRES_PORT="5432"

# ── Adresses ───────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3001"
# Gravée dans le paquet JavaScript au moment du build : la changer impose
# `docker compose build frontend`, un redémarrage ne suffit pas.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Nombre de proxys entre Internet et le serveur, ou « false » s'il n'y en a
# aucun. Derrière un reverse proxy : « 1 ».
TRUST_PROXY="false"

# ── Email ──────────────────────────────────────────────────────────────────
# « log » : rien ne part, tout va au journal du serveur. C'est utilisable
# pour essayer le produit, mais la réinitialisation de mot de passe ne
# fonctionne alors POUR PERSONNE — quelqu'un qui oublie son mot de passe
# reste dehors. Passer à « smtp » dès qu'il y a de vrais utilisateurs.
MAIL_TRANSPORT="log"
MAIL_FROM="Ignitux <bonjour@exemple.test>"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# ── IA ─────────────────────────────────────────────────────────────────────
# Éteinte par défaut : une composition lancée pour essayer ne doit pas se
# mettre à dépenser du budget sans qu'on l'ait demandé.
IGINI_AI_ENABLED="false"
ANTHROPIC_API_KEY=""

# ── Identité légale ────────────────────────────────────────────────────────
IGNITUX_RAISON_SOCIALE="Ignitux"
IGNITUX_ADRESSE=""
IGNITUX_EMAIL=""
IGNITUX_IBAN=""
IGNITUX_BIC=""
PAIEMENT_FOURNISSEUR="aucun"
