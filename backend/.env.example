DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change-me-generate-a-long-random-secret"
JWT_EXPIRES_IN="1d"
FRONTEND_URL="http://localhost:3001"
ANTHROPIC_API_KEY="sk-ant-..."

# Interrupteur des 5 générateurs IGINI (Analyser, Construire, Financer,
# Développer, Transmettre) — les seules fonctionnalités qui consomment du
# budget IA. Absente ou à toute autre valeur : le produit est complet.
# "false" : les générateurs sont éteints en amont de tout appel réseau, et
# l'interface affiche « Fonctionnalité IA non disponible » au lieu d'un
# bouton qui échouerait. À utiliser pour une session de test sans budget.
IGINI_AI_ENABLED="true"
