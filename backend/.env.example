# ---------------------------------------------------------------------------
# DEUX BASES, DEUX FICHIERS
#
# Depuis le 19/09/2026, le développement et les sessions avec de vraies
# personnes n'écrivent plus dans la même base. Voir docs/decisions.md,
# « Séparer la base de développement de celle des vraies personnes ».
#
#   .env             → base de développement  (…/postgres)
#   .env.production  → base de production     (…/ignitux_prod)
#
# Les deux fichiers sont ignorés par git. Seul ce modèle est versionné, et il
# ne doit jamais contenir de vraie valeur.
# ---------------------------------------------------------------------------

# Base de DÉVELOPPEMENT. Pour la production, le même hôte et les mêmes
# identifiants, mais le chemin final devient /ignitux_prod.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# 32 caractères minimum. En production, un secret DIFFÉRENT de celui de dev :
# un jeton signé en dev ne doit pas ouvrir une session en production.
JWT_SECRET="change-me-generate-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Doit correspondre à l'origine réelle du frontend, sinon CORS bloque tout.
FRONTEND_URL="http://localhost:3001"

ANTHROPIC_API_KEY="sk-ant-..."

# Interrupteur des 5 générateurs IGINI (Analyser, Construire, Financer,
# Développer, Transmettre) — les seules fonctionnalités qui consomment du
# budget IA. Absente ou à toute autre valeur : le produit est complet.
# "false" : les générateurs sont éteints en amont de tout appel réseau, et
# l'interface affiche « Fonctionnalité IA non disponible » au lieu d'un
# bouton qui échouerait. À utiliser pour une session de test sans budget.
IGINI_AI_ENABLED="true"
