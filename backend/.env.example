# ---------------------------------------------------------------------------
# DEUX BASES, DEUX FICHIERS
#
# Depuis le 19/09/2026, le développement et les sessions avec de vraies
# personnes n'écrivent plus dans la même base. Voir docs/decisions.md,
# « Séparer la base de développement de celle des vraies personnes ».
#
#   .env             → base de développement  (…/postgres)
#   .env.production  → base de production     (…/ignitux_prod)
#
# Les deux fichiers sont ignorés par git. Seul ce modèle est versionné, et il
# ne doit jamais contenir de vraie valeur.
# ---------------------------------------------------------------------------

# Base de DÉVELOPPEMENT. Pour la production, le même hôte et les mêmes
# identifiants, mais le chemin final devient /ignitux_prod.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# 32 caractères minimum. En production, un secret DIFFÉRENT de celui de dev :
# un jeton signé en dev ne doit pas ouvrir une session en production.
JWT_SECRET="change-me-generate-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Doit correspondre à l'origine réelle du frontend, sinon CORS bloque tout.
FRONTEND_URL="http://localhost:3001"

ANTHROPIC_API_KEY="sk-ant-..."

# Interrupteur des 5 générateurs IGINI (Analyser, Construire, Financer,
# Développer, Transmettre) — les seules fonctionnalités qui consomment du
# budget IA. Absente ou à toute autre valeur : le produit est complet.
# "false" : les générateurs sont éteints en amont de tout appel réseau, et
# l'interface affiche « Fonctionnalité IA non disponible » au lieu d'un
# bouton qui échouerait. À utiliser pour une session de test sans budget.
IGINI_AI_ENABLED="true"

# ---------------------------------------------------------------------------
# MISE EN PRODUCTION
#
# Les quatre réglages ci-dessous ne sont exigés que lorsque NODE_ENV vaut
# « production ». Le serveur REFUSE alors de démarrer tant qu'ils ne sont pas
# posés — non par rigidité, mais parce que chacun, mal réglé, produit une
# panne SILENCIEUSE : le serveur démarre, répond, et se comporte mal sans
# qu'aucune erreur ne le signale.
# ---------------------------------------------------------------------------

NODE_ENV="development"

# Le nombre de proxys entre Internet et ce serveur, ou « false » s'il n'y en
# a aucun. Express ne peut pas le deviner, et les deux erreurs sont muettes :
# ne rien déclarer derrière un proxy met toutes les personnes dans le même
# seau de limitation (une seule peut alors verrouiller tous les comptes) ;
# tout déclarer sans proxy laisse un client forger son en-tête
# X-Forwarded-For et se rendre invisible du limiteur.
TRUST_PROXY="false"

# « smtp » ou « log ». « log » écrit les messages dans le journal du serveur
# au lieu de les envoyer : utilisable, mais la réinitialisation de mot de
# passe ne fonctionne alors pour personne. C'est une décision acceptable ;
# ce qui ne l'est pas, c'est de l'obtenir par omission.
MAIL_TRANSPORT="log"

# Requis uniquement si MAIL_TRANSPORT="smtp". Fonctionne avec n'importe quel
# fournisseur (SES, Postmark, Resend, Brevo, un serveur maison) : c'est le
# plus petit dénominateur commun, et il évite d'enfermer le produit dans une
# API propriétaire avant que le choix ne soit fait.
MAIL_FROM="Ignitux <bonjour@exemple.com>"
SMTP_HOST="smtp.exemple.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# « true » sert /docs en production. Éteint par défaut : cette page décrit
# toute la surface de l'API. La sécurité ne tient pas au secret des routes,
# mais rien n'oblige à fournir le plan.
ENABLE_API_DOCS="false"

# ---------------------------------------------------------------------------
# IDENTITÉ LÉGALE D'IGNITUX
#
# Ce qui apparaît sur une facture d'abonnement et sur la page de mentions
# légales. Aucune de ces valeurs n'est écrite dans les sources : une raison
# sociale ou un IBAN figé dans le dépôt y reste lisible dans l'historique
# Git même après avoir été retiré du fichier.
#
# Les trois premières sont exigées en production : une facture sans raison
# sociale ni adresse n'est pas incomplète, elle est sans valeur.
# ---------------------------------------------------------------------------

IGNITUX_RAISON_SOCIALE=""
IGNITUX_ADRESSE=""
IGNITUX_EMAIL=""

# SIREN/SIRET, quand l'immatriculation existe. Vide avant.
IGNITUX_IDENTIFIANT=""
# Numéro de TVA intracommunautaire, si assujetti. Vide sinon.
IGNITUX_TVA=""

# Coordonnées bancaires. L'IBAN n'est jamais rendu entier par une réponse
# HTTP : seuls le pays et les quatre derniers caractères s'affichent.
IGNITUX_IBAN=""
IGNITUX_BIC=""

# ---------------------------------------------------------------------------
# FOURNISSEUR DE PAIEMENT
#
# « aucun » tant qu'aucun encaissement réel n'a lieu : les offres
# s'affichent, rien ne se facture, et le produit le dit au lieu de proposer
# un bouton qui échouerait.
#
# Les clés secrètes ne sont lues que par le module qui appelle le
# fournisseur, jamais chargées dans une structure qui traverserait
# l'application.
# ---------------------------------------------------------------------------

PAIEMENT_FOURNISSEUR="aucun"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
