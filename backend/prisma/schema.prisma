generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String                   @unique
  password_hash             String
  // null tant que l'email n'a pas ete verifie via le lien envoye a l'inscription.
  email_verified_at         DateTime?                @db.Timestamptz(6)
  created_at                DateTime?                @default(now()) @db.Timestamptz(6)
  projects                  projects[]
  memories                  memories[]
  chat_messages             chat_messages[]
  concepts                  concepts[]
  community_comments        community_comments[]
  collaborations            project_collaborators[]
  auth_tokens               auth_tokens[]
  marketplace_profile       marketplace_profiles?
  marketplace_contacts_sent marketplace_contacts[]
  crm_companies             crm_companies[]
  crm_contacts              crm_contacts[]
  billing_documents         billing_documents[]
  stock_items               stock_items[]
  agenda_events             agenda_events[]
  cash_register_entries     cash_register_entries[]
  real_estate_properties    real_estate_properties[]
  fleet_vehicles            fleet_vehicles[]
  ad_campaigns              ad_campaigns[]
  roles                     user_roles[]
  applications              user_applications[]
  profile                   user_profiles?
  subscription              subscriptions?
  identity_verifications    identity_verifications[]
  mandates                  mandates[]
  /// Le rôle sous lequel la personne travaille en ce moment. Rangé ici et
  /// non dans le navigateur pour que le mode suive la personne d une
  /// machine à l autre. null tant qu elle n a pas choisi.
  active_role               String?
  company_bylaws   company_bylaws[]
  creation_filings creation_filings[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auth_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // Seul le hash est stocke, jamais le token en clair (meme principe que les
  // mots de passe) : un vol de la base ne suffit pas a rejouer un lien de
  // reinitialisation ou de verification.
  token_hash String    @unique
  // 'password_reset' | 'email_verification'
  purpose    String
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model projects {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id               String                      @db.Uuid
  owner                  users                       @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  // Le secteur DU PROJET, pas celui de la personne.
  //
  // user_profiles.sectors dit « où tu as déjà travaillé » : c'est une
  // expérience. Quelqu'un venu du logiciel peut ouvrir une friterie, et
  // trier ses obligations légales sur son passé lui cacherait l'hygiène
  // alimentaire. Les deux champs ne sont donc pas interchangeables.
  //
  // Nullable, et il le restera : la conformité s'affiche entière sans lui,
  // simplement pas triée.
  sector               String?
  /// 'micro-entreprise' | 'EI' | 'EURL' | 'SASU' | 'SARL' | 'SAS' — ce que la
  /// personne a retenu, pas seulement ce que Former a recommandé. Nullable
  /// tant qu'elle n'a rien confirmé.
  confirmed_legal_form String?
  // Un projet public est visible dans la communauté (lecture seule pour les
  // autres utilisateurs, qui peuvent y laisser des encouragements) — false
  // par défaut, l'utilisateur décide explicitement de le rendre public.
  is_public            Boolean                     @default(false)
  created_at           DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?                   @updatedAt @db.Timestamptz(6)
  analyses             analyses[]
  legal_form_recommendations legal_form_recommendations[]
  build_plans          build_plans[]
  financing_plans      financing_plans[]
  development_plans    development_plans[]
  transmission_plans   transmission_plans[]
  memories             memories[]
  concepts             concepts[]
  tasks                tasks[]
  community_comments   community_comments[]
  collaborators        project_collaborators[]
  compliance_checks    project_compliance_checks[]
  compliance_ai_runs   project_compliance_ai_runs[]
  score_snapshots      score_snapshots[]
  automation_runs      automation_runs[]
  workflow_definitions workflow_definitions[]
  workflow_runs        workflow_runs[]
  crm_contacts         crm_contacts[]
  billing_documents    billing_documents[]
  stock_items          stock_items[]
  shopify_connection   shopify_connections?
  agenda_events        agenda_events[]
  real_estate_properties real_estate_properties[]
  fleet_vehicles       fleet_vehicles[]
  ad_campaigns         ad_campaigns[]
  financing_rounds     financing_rounds[]
  equity_holders       equity_holders[]
  equity_events        equity_events[]
  dividends            dividend_distributions[]
  buyback_objectives   buyback_objectives[]
  participation_agreement participation_agreements?
  financedProjects     financed_projects?
  bylaws           company_bylaws?
  creation_filing  creation_filings?

  mandates             mandates[]

  @@index([owner_id])
  @@index([is_public])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model analyses {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String    @db.Uuid
  project           projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  summary           String
  feasibility_score Int
  /// Pourquoi ce score, dans les mots du modèle qui l'a donné.
  ///
  /// Un chiffre sans sa raison est invérifiable : on ne peut ni le
  /// contester, ni savoir ce qu'il faudrait corriger pour le faire monter.
  /// C'est l'esprit de l'article 10 applique non a l'existence de la source
  /// mais a sa lisibilite.
  ///
  /// Nullable : les analyses produites avant ce champ n'en ont pas, et
  /// leur en fabriquer un apres coup serait exactement l'invention que le
  /// champ cherche a eviter.
  score_rationale   String?
  strengths         String[]
  risks             String[]
  next_steps        String[]
  // Provenance — voir constitution_articles, article « pas d'informations
  // simulées présentées comme réelles » : rien en base ne distinguait un
  // contenu produit par un modèle d'un contenu saisi par un humain. Les
  // lignes créées avant cette traçabilité ont generated_model = null, ce qui
  // se lit « modèle inconnu » et non « rédigé par un humain ».
  generated_by      String    @default("igini")
  generated_model   String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  sources           analysis_sources[]

  @@index([project_id])
}

/// Les pages réellement consultées par la recherche web pendant une analyse
/// — jamais des URLs que le modèle prétendrait avoir vues. Une table à part
/// et non un champ Json : une source est une ligne comme une autre, avec sa
/// propre date, et Ignitux n'a nulle part ailleurs de colonne Json dans ce
/// schéma. Même esprit que score_rationale ci-dessus : ce que le produit
/// affirme doit rester vérifiable, jamais recomposé après coup.
model analysis_sources {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id String    @db.Uuid
  analysis    analyses  @relation(fields: [analysis_id], references: [id], onDelete: Cascade)
  title       String
  url         String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([analysis_id])
}

/// La forme juridique qu'IGINI recommande pour un projet, jamais une
/// décision prise à la place de la personne — voir le cadrage du prompt
/// dans former.service.ts. Une table à part par entreprise, pas une
/// colonne sur `analyses` : le générateur Former est indépendant
/// d'Analyser, même s'il se déclenche souvent juste après.
model legal_form_recommendations {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String    @db.Uuid
  project           projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  /// 'micro-entreprise' | 'EI' | 'EURL' | 'SASU' | 'SARL' | 'SAS'
  recommended_form  String
  rationale         String
  points_to_check   String[]
  // Provenance — même convention que analyses.generated_by.
  generated_by      String    @default("igini")
  generated_model   String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)

  assumptions       legal_form_assumptions[]
  alternatives      legal_form_alternatives[]
  sources           legal_form_sources[]

  @@index([project_id])
}

/// Une hypothèse qu'IGINI a prise faute d'information dans le projet —
/// jamais tue : le sujet, l'hypothèse retenue, et comment la corriger si
/// elle est fausse.
model legal_form_assumptions {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendation_id  String                     @db.Uuid
  recommendation     legal_form_recommendations @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)
  subject            String
  assumption         String
  how_to_correct     String

  @@index([recommendation_id])
}

/// Une forme sérieusement envisagée mais pas retenue, et pourquoi.
model legal_form_alternatives {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendation_id  String                     @db.Uuid
  recommendation     legal_form_recommendations @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)
  /// 'micro-entreprise' | 'EI' | 'EURL' | 'SASU' | 'SARL' | 'SAS'
  form               String
  why_not_chosen     String

  @@index([recommendation_id])
}

/// Même rôle que analysis_sources : les pages réellement consultées par
/// la recherche web, jamais des URLs récitées de mémoire.
model legal_form_sources {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendation_id  String                     @db.Uuid
  recommendation     legal_form_recommendations @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)
  title              String
  url                String

  @@index([recommendation_id])
}

model company_bylaws {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id         String    @db.Uuid
  owner            users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  project_id       String    @unique @db.Uuid
  project          projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  // Copie de la forme confirmée au moment de la génération : le document
  // garde une trace de ce pour quoi il a été écrit, même si la
  // confirmation change ensuite sur le projet.
  legal_form       String
  capital_cents    Int
  head_office      String
  duration_years   Int
  content          String
  status           String    @default("brouillon") // 'brouillon' | 'retenue'
  finalized_at     DateTime? @db.Timestamptz(6)
  // Même convention que legal_form_recommendations.generated_by/generated_model.
  generated_by     String    @default("igini")
  generated_model  String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)

  associates       bylaw_associates[]
  @@index([owner_id])
}

model bylaw_associates {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bylaws_id          String          @db.Uuid
  bylaws             company_bylaws  @relation(fields: [bylaws_id], references: [id], onDelete: Cascade)
  full_name          String
  // Points de base : 10000 = 100 %. Convention déjà établie par
  // equity_events.share_basis_points — voir Global Constraints.
  share_basis_points Int
  created_at         DateTime?       @default(now()) @db.Timestamptz(6)

  @@index([bylaws_id])
}

