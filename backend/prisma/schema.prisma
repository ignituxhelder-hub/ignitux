/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model memories {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project_id String?   @db.Uuid
  project    projects? @relation(fields: [project_id], references: [id], onDelete: Cascade)
  // 'decision' | 'preference' | 'learning' | 'fact' — validé au niveau DTO,
  // pas en enum Prisma (convention déjà suivie ailleurs dans ce schéma).
  category   String
  content    String
  // Étiquettes saisies par l'utilisateur, jamais déduites automatiquement :
  // inventer des tags à sa place produirait un classement qui a l'air d'être
  // le sien sans l'être.
  tags       String[]
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id])
  @@index([project_id])
  @@index([category])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// CHAT — un message échangé librement avec Igini, en dehors des
/// générateurs structurés. Un seul fil continu par utilisateur : le rôle
/// (`role`) porte la distinction entre ce que la personne a écrit et ce
/// qu'Igini a répondu. Ne stocke jamais le détail des appels d'outils
/// (analyser/construire/...) qu'un tour de conversation a pu déclencher —
/// seule la réponse finale en langage naturel est conservée ici.
model chat_messages {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// 'user' | 'igini'
  role       String
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model concepts {
