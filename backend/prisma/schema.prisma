/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tasks {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String    @db.Uuid
  project     projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  title       String
  description String?
  // 'pending' | 'in_progress' | 'done' | 'blocked'
  status      String    @default("pending")
  // 'human' | 'igini' — qui est censé agir (autonomie supervisée : IGINI
  // peut proposer/exécuter, l'humain valide toujours).
  assignee    String    @default("human")
  // D'où vient la tâche : 'analysis' | 'build_plan' | 'manual', etc.
  source      String    @default("manual")
  // Échéance facultative, affichée par Agenda à côté des rendez-vous. Ajout
  // additif : les tâches créées avant ce champ n'en ont simplement pas.
  due_date    DateTime? @db.Timestamptz(6)
  // Exécution par IGINI (ajout additif, tout nullable : les tâches existantes
  // n'ont simplement aucune exécution IA).
  // 'a_valider' | 'valide' | 'refuse' | 'echec'
  ai_status         String?
  // Nature du résultat : 'livrable' | 'instructions' (null tant qu'il n'y en a pas)
  ai_result_kind    String?
  // Le résultat produit par IGINI — un brouillon à relire, jamais un acte.
  ai_result         String?
  // Pourquoi la personne a refusé le résultat d'IGINI : renvoyé dans le prompt
  // de la nouvelle tentative.
  ai_refusal_reason String?
  ai_run_at         DateTime? @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)

  @@index([project_id])
}

