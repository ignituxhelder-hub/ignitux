/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// COMPLIANCE — liste de référence (pas par utilisateur) des démarches
/// réglementaires françaises pour créer/faire tourner une petite activité.
/// Contenu rédigé à partir de sources publiques citées (source_name/
/// source_url), volontairement générique et non exhaustif : ce n'est pas un
/// avis juridique, voir backend/src/compliance/compliance-requirements.ts.
model compliance_requirements {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Clé stable pour semer/mettre à jour la liste au démarrage (upsert) sans
  // dupliquer de lignes — pas un identifiant métier exposé ailleurs.
  slug        String    @unique
  country     String
  category    String
  title       String
  description String
  source_name String
  source_url  String
  // Les secteurs que la démarche vise explicitement.
  //
  // Liste vide = elle concerne toute activité. Elle sert à TRIER, jamais à
  // filtrer : une démarche rattachée à un autre secteur descend en bas de
  // liste, elle ne disparaît pas. Masquer une obligation légale produirait
  // un faux négatif, et un faux négatif ici coûte bien plus cher que du
  // bruit (voir compliance-pertinence.ts).
  sectors     String[]  @default([])
  // Le jour où la source a été ouverte et lue pour la dernière fois.
  //
  // Une source morte est pire qu'absente : elle a l'air vérifiée. Le
  // domaine service-public.fr a migré, des fiches ont changé d'identifiant,
  // et sept des treize liens d'origine renvoyaient un 404 sans que rien ne
  // le signale. Cette date rend la péremption visible.
  verified_on DateTime? @db.Date
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  checks project_compliance_checks[]
  ai_runs project_compliance_ai_runs[]

  @@index([country])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model project_compliance_checks {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id     String                  @db.Uuid
  project        projects                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requirement_id String                  @db.Uuid
  requirement    compliance_requirements @relation(fields: [requirement_id], references: [id], onDelete: Cascade)
  completed_at   DateTime?               @default(now()) @db.Timestamptz(6)

  @@unique([project_id, requirement_id])
  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// COMPLIANCE — dernière exécution d'IGINI pour une démarche d'un projet
/// (un brouillon à relire, jamais un acte accompli). Une seule ligne par
/// (projet, démarche) : relancer remplace le résultat précédent.
model project_compliance_ai_runs {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id     String                  @db.Uuid
  project        projects                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requirement_id String                  @db.Uuid
  requirement    compliance_requirements @relation(fields: [requirement_id], references: [id], onDelete: Cascade)
  // 'a_valider' | 'valide' | 'refuse' | 'echec'
  status         String
  result_kind    String?
  result         String?
  refusal_reason String?
  created_at     DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?               @updatedAt @db.Timestamptz(6)

  @@unique([project_id, requirement_id])
  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// MARKETPLACE — annuaire de mentors/investisseurs et mise en relation par
/// message, volontairement sans aucune circulation d'argent dans l'app (pas
/// de paiement, pas de gestion de participation) — voir docs/decisions.md.
model marketplace_profiles {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @unique @db.Uuid
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // 'mentor' | 'investisseur'
  role       String
  headline   String
  bio        String?
  expertise  String[]
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  contacts_received marketplace_contacts[] @relation("marketplace_contact_profile")

  @@index([role])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model marketplace_contacts {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_user_id  String               @db.Uuid
  from_user     users                @relation(fields: [from_user_id], references: [id], onDelete: Cascade)
  to_profile_id String               @db.Uuid
  to_profile    marketplace_profiles @relation("marketplace_contact_profile", fields: [to_profile_id], references: [id], onDelete: Cascade)
  message       String
  created_at    DateTime?            @default(now()) @db.Timestamptz(6)

  @@index([to_profile_id])
  @@index([from_user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// AUTOMATION — le cinquième moteur : contrairement aux 4 autres (mémoire,
/// connaissance, workflow, score), celui-ci agit sans confirmation humaine
/// préalable (voir backend/src/igini/automation/automation.service.ts pour
/// le détail de ce qu'il fait et pourquoi il n'appelle jamais Claude
/// lui-même). Cette table est la trace de ce qu'il a fait, consultable après
/// coup — la transparence remplace la confirmation préalable.
model automation_runs {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                  String    @db.Uuid
  project                     projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks_created_count         Int       @default(0)
  tasks_closed_count          Int       @default(0)
  concept_links_created_count Int       @default(0)
  created_at                  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([project_id])
}

/// FINANCEMENT — un apport de fonds sur un projet, d'où qu'il vienne.
/// Enregistré quand il a réellement eu lieu, jamais prévu : une promesse
/// de financement n'est pas un financement.
model financing_rounds {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id   String    @db.Uuid
  project      projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  /// 'ignitux' | 'porteur' | 'pret' | 'subvention' | 'autre'
  source       String
  amount_cents Int
  occurred_at  DateTime  @db.Timestamptz(6)
  note         String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([project_id])
}

/// FINANCEMENT — un détenteur de parts sur un projet.
/// `is_founder` distingue le porteur du projet des autres détenteurs :
/// le modèle Ignitux pose que l'entrepreneur reste propriétaire
/// principal, et cette qualité doit être lisible en base, pas déduite
/// d'un pourcentage à un instant donné.
model equity_holders {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String    @db.Uuid
  project    projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  name       String
  is_founder Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  equity_events  equity_events[]
  dividends      dividend_distributions[]
  participations participations[]
  founder_agreement participation_agreements? @relation("agreement_founder")
  ignitux_agreement participation_agreements? @relation("agreement_ignitux")

  @@index([project_id])
}

/// FINANCEMENT — un changement de répartition des parts, daté et motivé.
///
/// La table stocke des ÉVÉNEMENTS, pas un état courant. La répartition
/// actuelle se lit comme le dernier événement de chaque détenteur. Ce
/// choix coûte une requête de plus, et il évite exactement ce que le
/// modèle Ignitux promet de rendre visible : l'évolution progressive vers
/// l'autonomie du porteur. Un simple champ « part actuelle » écraserait
/// cette histoire à chaque modification.
///
/// `share_basis_points` est la part APRÈS l'événement, en points de base
/// (10000 = 100 %), pour représenter 12,5 % sans flottant.
model equity_events {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id         String         @db.Uuid
  project            projects       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  holder_id          String         @db.Uuid
  holder             equity_holders @relation(fields: [holder_id], references: [id], onDelete: Cascade)
  share_basis_points Int
  /// Pourquoi la part change : « rachat par le porteur », « entrée au
  /// capital »… Saisi par l'humain, jamais déduit.
  reason             String
  occurred_at        DateTime       @db.Timestamptz(6)
  created_at         DateTime?      @default(now()) @db.Timestamptz(6)

  @@index([project_id])
  @@index([holder_id])
}

/// FINANCEMENT — un dividende réellement versé.
/// Il n'existe aucune table de dividende « prévu » : un dividende se
/// constate, il ne se prédit pas (voir financing-legal.ts).
model dividend_distributions {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id           String         @db.Uuid
  project              projects       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  holder_id            String         @db.Uuid
  holder               equity_holders @relation(fields: [holder_id], references: [id], onDelete: Cascade)
  amount_cents         Int
  occurred_at          DateTime       @db.Timestamptz(6)
  note                 String?
  /// Le mouvement d investisseur dont cette ligne est la projection.
  ///
  /// Deux tables enregistrent un dividende, vu sous deux angles : celle-ci
  /// par detenteur de parts, investor_movements par investisseur. Elles ne
  /// sont pas deux verites concurrentes — depuis la consolidation, le
  /// moteur d investissement ecrit les deux dans la meme transaction et
  /// pose ce lien. null = ligne saisie a la main, pour un detenteur qui n
  /// est pas un investisseur enregistre. Unique, pour qu un mouvement ne
  /// puisse pas produire deux projections.
  /// Pas de contrainte d unicite en base, et c est un choix contraint : la
  /// poser exigerait le drapeau --accept-data-loss, que les consignes du
  /// depot reservent a un consentement explicite du porteur. L unicite est
  /// donc tenue par le service — qui ecrit les deux lignes dans la meme
  /// transaction — et verifiee apres coup par l audit financier. A poser en
  /// index le jour d une vraie migration.
  investor_movement_id String?        @db.Uuid
  created_at           DateTime?      @default(now()) @db.Timestamptz(6)

  @@index([project_id])
  @@index([holder_id])
}

/// PARTICIPATION IGNITUX — l'accord qui lie un projet à IGNITUX.
///
/// Un accord = trois choses distinctes, jamais mélangées :
///   1. le CAPITAL, qui reste dans `equity_events` (seule autorité) ;
///   2. le DROIT ÉCONOMIQUE, un pourcentage des dividendes distribués, dû
///      uniquement quand IGNITUX est à 0 % du capital (`dividend_right_entries`) ;
///   3. l'ACCÈS À L'ÉCOSYSTÈME, porté par `ecosystem_offre`, indépendant du
///      capital : il ne disparaît pas quand IGNITUX passe à 0 %.
///
/// Les parts de départ et le taux du droit sont ceux DE CET ACCORD, copiés à
/// sa création depuis des valeurs par défaut. Aucun délai, aucune échéance :
/// la progression passe par `participation_milestones`, validés à la main.
model participation_agreements {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String         @unique @db.Uuid
  project             projects       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  /// Les deux détenteurs du capital. NoAction : supprimer un détenteur
  /// effacerait en cascade l'historique de la transmission.
  founder_holder_id   String         @unique @db.Uuid
  founder_holder      equity_holders @relation("agreement_founder", fields: [founder_holder_id], references: [id], onDelete: NoAction)
  ignitux_holder_id   String         @unique @db.Uuid
  ignitux_holder      equity_holders @relation("agreement_ignitux", fields: [ignitux_holder_id], references: [id], onDelete: NoAction)
  /// La répartition de départ, en points de base. Fait historique : la part
  /// d'aujourd'hui se lit dans `equity_events`.
  initial_founder_bps Int
  initial_ignitux_bps Int
  /// Le droit sur les dividendes DISTRIBUÉS, en points de base. Propre à
  /// l'accord ; jamais une part de capital.
  dividend_right_bps  Int
  /// 'actif' | 'transmis' | 'clos'. 'transmis' = IGNITUX est à 0 % du capital.
  status              String         @default("actif")
  effective_on        DateTime       @db.Date
  /// Référence du contrat signé, quand il existe (validation juridique).
  contract_reference  String?
  /// L'offre que le contrat garantit à l'entrepreneur. Chaîne libre comme
  /// `subscriptions.offre` : le catalogue reste l'autorité.
  ecosystem_offre     String         @default("entrepreneur")
  /// Le jour où IGNITUX est passé à 0 % du capital. C'est ce qui ouvre le
  /// droit sur les dividendes.
  transmitted_on      DateTime?      @db.Date
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?      @updatedAt @db.Timestamptz(6)

  milestones      participation_milestones[]
  dividend_rights dividend_right_entries[]

  @@index([status])
}

/// PARTICIPATION IGNITUX — un palier de la transmission du capital.
///
/// Un palier n'est JAMAIS déclenché par le temps : aucune colonne ici ne
/// porte une durée ni une échéance automatique. Il passe de 'prevu' à
/// 'valide' quand IGNITUX constate que les conditions définies pour ce projet
/// sont remplies, puis à 'execute' quand le capital est réellement modifié.
/// L'entrepreneur peut en prendre connaissance (`founder_acknowledged_at`),
/// ce qui ne remplace jamais la validation d'IGNITUX.
model participation_milestones {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agreement_id            String                   @db.Uuid
  agreement               participation_agreements @relation(fields: [agreement_id], references: [id], onDelete: Cascade)
  /// L'ordre des paliers. La part visée décroît strictement avec la position.
  position                Int
  label                   String?
  /// La part d'IGNITUX visée APRÈS ce palier, en points de base.
  target_ignitux_bps      Int
  /// Les conditions de ce palier, propres au projet, écrites par une personne.
  /// Vide = « conditions à définir » : le produit n'en invente aucune.
  conditions              String[]
  /// 'prevu' | 'valide' | 'execute' | 'abandonne'
  status                  String                   @default("prevu")
  validated_at            DateTime?                @db.Timestamptz(6)
  /// Qui, côté IGNITUX, a validé. Jamais l'entrepreneur seul.
  validated_by            String?                  @db.Uuid
  validation_note         String?
  founder_acknowledged_at DateTime?                @db.Timestamptz(6)
  effective_on            DateTime?                @db.Date
  executed_at             DateTime?                @db.Timestamptz(6)
  /// Les événements de capital écrits à l'exécution (porteur + IGNITUX).
  equity_event_ids        String[]
  created_at              DateTime?                @default(now()) @db.Timestamptz(6)

  @@unique([agreement_id, position])
  @@index([agreement_id])
}

/// PARTICIPATION IGNITUX — le droit économique sur un dividende distribué.
///
/// Registre SÉPARÉ du capital : ces lignes ne sont jamais des parts. Une ligne
/// naît d'un dividende réellement distribué, et seulement après transmission
/// complète du capital. Sans dividende, aucune ligne, aucun paiement.
model dividend_right_entries {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agreement_id      String                   @db.Uuid
  agreement         participation_agreements @relation(fields: [agreement_id], references: [id], onDelete: Cascade)
  /// Le dividende total effectivement distribué.
  distributed_cents Int
  /// Le taux de l'accord AU MOMENT du constat, recopié : changer l'accord
  /// plus tard ne réécrit pas ce qui était dû.
  right_bps         Int
  due_cents         Int
  occurred_on       DateTime                 @db.Date
  /// 'du' | 'regle'
  status            String                   @default("du")
  settled_on        DateTime?                @db.Date
  note              String?
  created_at        DateTime?                @default(now()) @db.Timestamptz(6)

  @@index([agreement_id])
}

/// FACTURATION — un document commercial : devis, facture ou avoir.
///
/// Trois contraintes structurent ce modèle, et elles viennent du droit
/// français, pas d'un choix esthétique :
///   1. la numérotation est séquentielle, chronologique et sans trou, par
///      type et par année (d'où la clé unique owner/type/year/sequence) ;
///   2. un document émis ne se modifie ni ne se supprime — une erreur se
///      corrige par un avoir qui le référence ;
///   3. les montants sont stockés en centimes entiers, jamais en flottant :
///      0.1 + 0.2 ≠ 0.3 en virgule flottante, et sur une facture cet écart
///      n'est pas une curiosité, c'est un litige.
///
/// Ce que ce modèle n'est PAS : un logiciel de facturation certifié au sens
/// de l'article 286-I-3° bis du CGI. Voir backend/src/billing/billing-legal.ts.
model billing_documents {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id   String        @db.Uuid
  owner      users         @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  contact_id String?       @db.Uuid
  contact    crm_contacts? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  project_id String?       @db.Uuid
  project    projects?     @relation(fields: [project_id], references: [id], onDelete: SetNull)

  // 'devis' | 'facture' | 'avoir'
  type     String
  year     Int
  sequence Int
  /// Numéro affiché, dérivé de type/year/sequence — figé à l'émission.
  number   String

  // 'brouillon' | 'emis' | 'paye' | 'annule' | 'refuse'
  status String @default("brouillon")

  /// Nom et adresse du client recopiés au moment de l'émission : si la
  /// fiche contact change ensuite, le document émis ne doit pas changer
  /// avec elle.
  client_name    String
  client_details String?

  currency String  @default("EUR")
  notes    String?

  /// Pour un avoir : le document qu'il corrige.
  corrects_id  String?             @db.Uuid
  corrects     billing_documents?  @relation("billing_correction", fields: [corrects_id], references: [id], onDelete: SetNull)
  corrected_by billing_documents[] @relation("billing_correction")

  issued_at  DateTime? @db.Timestamptz(6)
  due_at     DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  lines    billing_lines[]
  payments billing_payments[]

  @@unique([owner_id, type, year, sequence])
  @@index([owner_id])
  @@index([contact_id])
  @@index([project_id])
  @@index([status])
}

/// FACTURATION — une ligne de document. `unit_price_cents` et
/// `vat_rate_basis_points` sont des entiers : voir l'explication sur les
/// montants dans billing_documents.
/// Le taux de TVA est saisi par l'utilisateur et jamais présumé : les taux
/// changent, diffèrent par activité et par pays, et en coder un en dur
/// reviendrait à fournir un chiffre réglementaire inventé.
model billing_lines {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id           String            @db.Uuid
  document              billing_documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  position              Int
  label                 String
  quantity_milli        Int
  unit_price_cents      Int
  /// Taux en pour mille (2000 = 20 %), pour représenter 5,5 % sans flottant.
  vat_rate_basis_points Int               @default(0)
  created_at            DateTime?         @default(now()) @db.Timestamptz(6)

  @@index([document_id])
}

/// FACTURATION — un règlement reçu sur un document.
model billing_payments {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id  String            @db.Uuid
  document     billing_documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  amount_cents Int
  /// 'virement' | 'especes' | 'carte' | 'cheque' | 'autre'
  method       String
  received_at  DateTime          @db.Timestamptz(6)
  note         String?
  created_at   DateTime?         @default(now()) @db.Timestamptz(6)

  @@index([document_id])
}

/// CRM — une entreprise avec laquelle le porteur est en relation.
/// Séparée des contacts parce qu'une même entreprise a plusieurs
/// interlocuteurs, et que perdre l'un ne doit pas perdre l'autre.
model crm_companies {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id   String    @db.Uuid
  owner      users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  name       String
  sector     String?
  website    String?
  notes      String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  contacts crm_contacts[]

  @@index([owner_id])
}

/// CRM — une personne. `kind` dit ce qu'elle est pour le porteur
/// (prospect, client…), `stage` où elle en est dans le pipeline
/// commercial. Les deux sont distincts : un client existant peut être en
/// cours de négociation sur une nouvelle offre.
model crm_contacts {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id   String         @db.Uuid
  owner      users          @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  company_id String?        @db.Uuid
  company    crm_companies? @relation(fields: [company_id], references: [id], onDelete: SetNull)
  // Rattachement facultatif à un projet : un contact peut concerner
  // l'activité en général et pas un projet précis.
  project_id String?        @db.Uuid
  project    projects?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  first_name String
  last_name  String
  email      String?
  phone      String?
  role       String?
  // 'prospect' | 'client' | 'partenaire' | 'autre'
  kind       String         @default("prospect")
  // 'nouveau' | 'contacte' | 'qualifie' | 'proposition' | 'gagne' | 'perdu'
  stage      String         @default("nouveau")
  notes      String?
  created_at DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at DateTime?      @updatedAt @db.Timestamptz(6)

  interactions      crm_interactions[]
  billing_documents billing_documents[]
  agenda_events     agenda_events[]

  @@index([owner_id])
  @@index([company_id])
  @@index([project_id])
  @@index([stage])
}

/// CRM — historique des échanges avec un contact.
/// `occurred_at` est distinct de `created_at` : on saisit souvent un appel
/// après coup, et dater l'échange du jour de la saisie fausserait
/// l'historique.
model crm_interactions {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id  String       @db.Uuid
  contact     crm_contacts @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  // 'appel' | 'email' | 'rendez_vous' | 'note'
  channel     String
  summary     String
  occurred_at DateTime     @db.Timestamptz(6)
  created_at  DateTime?    @default(now()) @db.Timestamptz(6)

  @@index([contact_id])
}

/// STOCKS — un article suivi en réserve. `quantity` est un solde
/// dénormalisé, recalculé à chaque mouvement plutôt qu'à la lecture : voir
/// stocks.service.ts pour pourquoi (le nombre de mouvements d'un article
/// actif rendrait un `aggregate` à chaque lecture coûteux sans raison).
model stock_items {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id    String    @db.Uuid
  owner       users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  // Rattachement facultatif à un projet, même convention que crm_contacts.
  project_id  String?   @db.Uuid
  project     projects? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  name        String
  // 'unite' | 'kg' | 'litre' | 'heure' | 'autre' — validé côté DTO, pas en
  // enum Prisma (même convention que crm_contacts.kind).
  unit        String    @default("unite")
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  // Seuil sous lequel l'article s'affiche en alerte. Nul = pas d'alerte.
  alert_below Decimal?  @db.Decimal(12, 3)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)

  movements stock_movements[]

  @@index([owner_id])
  @@index([project_id])
}

model shopify_connections {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id            String    @unique @db.Uuid
  shop_domain           String
  access_token_chiffre  String
  scopes                String
  forfait_declare       String?
  prix_declare_centimes Int?
  connected_at          DateTime  @default(now()) @db.Timestamptz(6)
  disconnected_at       DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @updatedAt @db.Timestamptz(6)

  project projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

/// STOCKS — une entrée ou une sortie sur un article. `quantity` est signée :
/// positive pour une entrée, négative pour une sortie. Historique immuable
/// une fois créé (pas d'update/delete) : corriger une erreur se fait par un
/// mouvement inverse, jamais en réécrivant l'histoire.
model stock_movements {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id     String      @db.Uuid
  item        stock_items @relation(fields: [item_id], references: [id], onDelete: Cascade)
  quantity    Decimal     @db.Decimal(12, 3)
  reason      String?
  occurred_on DateTime    @db.Date
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)

  @@index([item_id])
}

/// AGENDA — un rendez-vous. Distinct des `tasks` à échéance (voir
/// tasks.due_date) : un rendez-vous et une tâche restent deux idées
/// différentes même si la page Agenda les affiche dans une même liste.
model agenda_events {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id    String        @db.Uuid
  owner       users         @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  project_id  String?       @db.Uuid
  project     projects?     @relation(fields: [project_id], references: [id], onDelete: SetNull)
  contact_id  String?       @db.Uuid
  contact     crm_contacts? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  title       String
  location    String?
  note        String?
  occurred_at DateTime      @db.Timestamptz(6)
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?     @updatedAt @db.Timestamptz(6)

  @@index([owner_id])
  @@index([project_id])
  @@index([contact_id])
}

/// CAISSE — le relevé de fin de journée d'une vraie caisse certifiée,
/// saisi à la main. IGNITUX n'encaisse jamais lui-même : voir
/// caisse.service.ts pour ce que ce module fait et ne fait pas.
model cash_register_entries {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id        String          @db.Uuid
  owner           users           @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  occurred_on     DateTime        @db.Date
  cash_cents      Int             @default(0)
  card_cents      Int             @default(0)
  // TVA collectée sur la journée, montant unique v1 (pas de ventilation par
  // taux — voir caisse.service.ts).
  vat_cents       Int             @default(0)
  note            String?
  // 'manuel' aujourd'hui ; réservé pour un futur 'import' quand un
  // prestataire de caisse certifiée sera choisi — même principe que
  // bank_accounts.provider.
  source          String          @default("manuel")
  ledger_entry_id String?         @db.Uuid
  ledger_entry    ledger_entries? @relation(fields: [ledger_entry_id], references: [id], onDelete: SetNull)
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)

  @@index([owner_id])
  @@index([ledger_entry_id])
}

/// WORKFLOW — définition d'un processus réutilisable pour un projet.
/// Une définition décrit ce qui DOIT arriver, dans quel ordre ; une
/// exécution (workflow_runs) décrit ce qui EST arrivé. Les deux sont
/// séparés pour qu'éditer un processus ne réécrive jamais l'histoire des
/// exécutions passées.
model workflow_definitions {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String    @db.Uuid
  project     projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  name        String
  description String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)

  steps workflow_steps[]
  runs  workflow_runs[]

  @@index([project_id])
}

/// WORKFLOW — une étape d'un processus.
/// `condition_*` décrit ce qui doit être vrai pour franchir l'étape ;
/// `action_*` ce que le moteur fait en y entrant. Les deux sont des
/// couples (type, valeur) volontairement pauvres : un mini-langage
/// d'expressions serait plus expressif et beaucoup moins vérifiable, or
/// une transition qu'on ne sait pas expliquer à l'utilisateur ne devrait
/// pas exister (voir backend/src/igini/workflow/workflow-conditions.ts).
model workflow_steps {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id     String               @db.Uuid
  workflow        workflow_definitions @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  position        Int
  title           String
  description     String?
  // 'always' | 'stage_exists' | 'tasks_done' | 'manual'
  condition_type  String               @default("always")
  condition_value String?
  // 'none' | 'create_task'
  action_type     String               @default("none")
  action_value    String?
  created_at      DateTime?            @default(now()) @db.Timestamptz(6)

  @@unique([workflow_id, position])
  @@index([workflow_id])
}

/// WORKFLOW — une exécution d'un processus sur un projet.
model workflow_runs {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id      String               @db.Uuid
  workflow         workflow_definitions @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  project_id       String               @db.Uuid
  project          projects             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  // 'running' | 'blocked' | 'completed'
  status           String               @default("running")
  // Position de l'étape en attente. Vaut le nombre d'étapes une fois
  // l'exécution terminée (aucune étape restante).
  current_position Int                  @default(0)
  started_at       DateTime?            @default(now()) @db.Timestamptz(6)
  completed_at     DateTime?            @db.Timestamptz(6)

  events workflow_events[]

  @@index([workflow_id])
  @@index([project_id])
}

/// WORKFLOW — journal d'une exécution. Comme automation_runs : le moteur
/// avance parfois sans confirmation, la transparence après coup est la
/// contrepartie (article 5).
model workflow_events {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id        String        @db.Uuid
  run           workflow_runs @relation(fields: [run_id], references: [id], onDelete: Cascade)
  step_position Int
  // 'step_completed' | 'blocked' | 'run_completed' | 'task_created'
  type          String
  detail        String
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)

  @@index([run_id])
}

/// CONSTITUTION — texte de référence (pas par utilisateur), semé au
/// démarrage comme compliance_requirements. Chaque article porte le principe
/// fondateur dont il découle et, surtout, son mode d'application : `enforced`
/// signifie qu'une règle du moteur le vérifie réellement dans le code,
/// `declared` qu'il s'agit d'un énoncé de valeur non vérifiable
/// automatiquement. Cette distinction est volontairement stockée en base :
/// prétendre qu'un article est appliqué alors qu'aucun code ne le vérifie
/// serait exactement l'inverse de « la vérité avant tout ».
/// Voir backend/src/constitution/constitution-articles.ts.
model constitution_articles {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Clé stable de semis (upsert), comme compliance_requirements.slug.
  slug        String    @unique
  // Version du texte d'où vient l'article. Permet de remplacer le corpus
  // actuel par la Constitution V1 officielle sans confondre les deux.
  version     String
  number      Int
  title       String
  text        String
  principle   String
  // 'enforced' | 'declared'
  enforcement String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([version])
}

/// CONSTITUTION — journal des violations relevées par le moteur.
/// user_id / project_id sont des UUID nus, sans clé étrangère : une trace
/// d'audit doit survivre à la suppression de ce qu'elle décrit, sinon elle
/// disparaît précisément dans les cas où elle compte le plus. Le prix
/// assumé est que ces colonnes peuvent pointer vers des lignes disparues.
model constitution_violations {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  article_slug String
  rule_id      String
  // 'blocking' | 'warning'
  severity     String
  // L'action soumise au moteur, ex. 'publish_score' ou 'persist_generated'.
  action       String
  detail       String
  user_id      String?   @db.Uuid
  project_id   String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([article_slug])
  @@index([created_at])
}

/// FINANCEMENT — les objectifs que le porteur se fixe pour racheter les
/// parts d'Ignitux.
///
/// Le modèle économique nomme trois conditions — rentabilité, autonomie,
/// stabilité — sans les chiffrer. Ignitux ne les invente pas : le porteur
/// écrit ce que chacune signifie pour SON projet, et c'est lui seul qui
/// déclare qu'elle est atteinte (`reached_at`). Le code conserve ce qu'il a
/// écrit, le date, et compte. Voir buyback-progress.ts.
///
/// La contrainte d'unicité (projet, condition) évite deux définitions
/// concurrentes de « rentabilité » sur un même projet : la condition doit
/// rester difficile à réinterpréter après coup, c'est sa raison d'être.
model buyback_objectives {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String    @db.Uuid
  project    projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  /// 'rentabilite' | 'autonomie' | 'stabilite'
  kind       String
  /// Ce que cette condition veut dire pour ce projet. Saisi par l'humain.
  definition String
  /// Déclaré atteint par le porteur, jamais déduit par Ignitux.
  reached_at DateTime? @db.Timestamptz(6)
  /// Sur quoi il s'appuie pour le dire.
  evidence   String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  @@unique([project_id, kind])
  @@index([project_id])
}

/// TÉLÉMÉTRIE IA — un enregistrement par appel facturé à l'API Anthropic.
///
/// Ce journal existe parce que son absence rendait quatre choses impossibles :
/// connaître le coût réel, poser un plafond, détecter un abus, et produire une
/// statistique qui ne soit pas une estimation. PRICING.md a dû chiffrer la
/// rentabilité en comptant des caractères sur des artefacts, faute de ces
/// lignes ; c'est ce que ce modèle remplace.
///
/// Pas de clé étrangère vers `users` ni `projects`, volontairement, et pour la
/// même raison que `constitution_violations` : la dépense a réellement eu lieu.
/// Si la suppression d'un compte effaçait ces lignes, le total mensuel déjà
/// facturé par Anthropic changerait rétroactivement, et la comptabilité
/// mentirait. À la suppression, `user_id` passe à null : le fait reste,
/// l'identité part.
///
/// Aucun montant en euros n'est stocké ici. Les tokens sont des faits mesurés ;
/// un prix est un calcul dont la grille change (celle de PRICING.md avait déjà
/// trois mois). Figer un montant reviendrait à sceller une grille périmée dans
/// la base pour toujours. Le coût se dérive à la lecture, via ai-pricing.ts.
model ai_usage_events {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                     String?   @db.Uuid
  project_id                  String?   @db.Uuid
  /// 'analyser' | 'construire' | 'financer' | 'developper' | 'transmettre'
  generator                   String
  /// Le modèle réellement appelé, pas une constante recopiée : la grille
  /// tarifaire dépend de lui, et un changement de modèle doit rester lisible
  /// dans l'historique.
  model                       String
  input_tokens                Int
  /// Total facturé en sortie, réflexion interne comprise.
  output_tokens               Int
  /// Sous-ensemble de output_tokens : la réflexion interne du modèle,
  /// facturée au tarif de sortie et jusqu'ici totalement invisible. C'est le
  /// trou que PRICING.md désignait comme le plus important. null quand le
  /// modèle ne l'expose pas.
  thinking_tokens             Int?
  cache_creation_input_tokens Int?
  cache_read_input_tokens     Int?
  /// Nombre de recherches web effectuées par cet appel — facturées 0,01 $
  /// chacune, en plus des tokens (voir WEB_SEARCH_MICRO_USD_PER_SEARCH dans
  /// ai-pricing.ts). null pour tout appel qui n'utilisait pas cet outil, y
  /// compris toutes les lignes antérieures à son introduction.
  web_search_requests         Int?
  /// Durée de l'appel côté serveur. Permet de croiser coût et latence, les
  /// deux seuls arbitrages réels sur le choix d'un modèle.
  duration_ms                 Int
  created_at                  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at])
  @@index([created_at])
  @@index([generator])
}

/// ─────────────────────────────────────────────────────────────────────────
/// SÉPARATION DES CAISSES — l'argent d'IGNITUX n'est jamais celui de la
/// personne.
///
/// Avant ces tables, tout ce que le produit suivait financièrement
/// appartenait aux utilisateurs : `billing_documents` sont les factures que
/// l'entrepreneur envoie à SES clients, `equity_holders` est la table de
/// capitalisation de SON projet. IGNITUX, lui, n'avait aucun livre — alors
/// même que `financing_rounds.source` peut valoir `'ignitux'`, c'est-à-dire
/// de l'argent d'IGNITUX entrant dans le projet de quelqu'un. Cette dépense
/// n'était enregistrée que du côté du bénéficiaire.
///
/// Le principe tenu ici : **toute écriture a un propriétaire, et une écriture
/// n'en a jamais deux.** Un mouvement entre IGNITUX et une personne n'est pas
/// une écriture à cheval : ce sont DEUX écritures, une dans chaque
/// comptabilité, qui se désignent l'une l'autre. C'est ce qui rend la
/// séparation vérifiable plutôt que déclarative.
///
/// `owner_type` et `owner_id` sont tous deux NOT NULL. La règle « aucune
/// transaction sans propriétaire » est donc tenue par le schéma lui-même, pas
/// seulement par du code. IGNITUX n'étant pas une ligne de `users`, il porte
/// un identifiant sentinelle documenté (voir ledger-owner.ts) plutôt qu'un
/// `null` : un `null` aurait rendu les contraintes d'unicité inopérantes
/// (deux `null` sont distincts en Postgres) et aurait fait de « sans
/// propriétaire » un état représentable.

/// COMPTABILITÉ — un compte du plan comptable, appartenant à IGNITUX ou à une
/// personne. Le plan de l'un n'est jamais celui de l'autre.
model ledger_accounts {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 'ignitux' | 'user'
  owner_type String
  /// L'utilisateur, ou l'identifiant sentinelle d'IGNITUX. Jamais null.
  owner_id   String    @db.Uuid
  /// Code du plan comptable, unique chez un propriétaire donné.
  code       String
  label      String
  /// 'actif' | 'passif' | 'capitaux' | 'produit' | 'charge'
  kind       String
  currency   String    @default("EUR")
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  lines        ledger_lines[]
  bank_account bank_accounts?

  @@unique([owner_type, owner_id, code])
  @@index([owner_type, owner_id])
}

/// COMPTABILITÉ — une écriture au journal. Équilibrée par construction :
/// la somme des débits égale la somme des crédits, vérifié avant écriture.
model ledger_entries {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_type           String
  owner_id             String    @db.Uuid
  occurred_on          DateTime  @db.Date
  label                String
  /// Ce que l'écriture constate, quand elle vient d'ailleurs dans le
  /// produit : identifiant de facture, de tour de financement, etc. Texte
  /// libre volontairement — une clé étrangère par origine possible aurait
  /// couplé le journal à tout le reste.
  reference            String?
  currency             String    @default("EUR")
  /// L'écriture jumelle, dans la comptabilité de l'AUTRE propriétaire, quand
  /// ce mouvement traverse la frontière entre les deux caisses. Nulle pour
  /// une écriture interne.
  ///
  /// Pas de clé étrangère : les deux écritures se créent dans la même
  /// transaction et se désignent mutuellement, ce qu'une contrainte
  /// référentielle rendrait impossible à poser sans écriture intermédiaire.
  /// La cohérence est vérifiée par un contrôle dédié, pas par la base.
  counterpart_entry_id String?   @db.Uuid
  created_at           DateTime? @default(now()) @db.Timestamptz(6)

  lines                 ledger_lines[]
  cash_register_entries cash_register_entries[]

  @@index([owner_type, owner_id, occurred_on])
  @@index([counterpart_entry_id])
}

/// COMPTABILITÉ — une ligne d'écriture. Un seul des deux montants est non nul :
/// le sens est porté par la colonne, jamais par un signe négatif.
model ledger_lines {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_id     String          @db.Uuid
  entry        ledger_entries  @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  account_id   String          @db.Uuid
  account      ledger_accounts @relation(fields: [account_id], references: [id], onDelete: Restrict)
  /// En centimes entiers, toujours positifs ou nuls.
  debit_cents  Int             @default(0)
  credit_cents Int             @default(0)
  description  String?

  @@index([entry_id])
  @@index([account_id])
}

/// BANQUE — un compte bancaire déclaré, appartenant à IGNITUX ou à une
/// personne.
///
/// **Aucun IBAN complet n'est stocké**, seulement les quatre derniers
/// caractères et un libellé : il n'existe aujourd'hui aucun virement ni
/// aucune synchronisation dans le produit, donc rien ne justifie de détenir
/// une coordonnée bancaire complète. Détenir une donnée qu'on ne sait pas
/// encore protéger ni utiliser est un risque sans contrepartie. Le jour où
/// un virement sera émis, ce champ devra être repensé avec un fournisseur
/// choisi — pas rempli en douce.
model bank_accounts {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_type        String
  owner_id          String           @db.Uuid
  label             String
  /// 'courant' | 'reserve' | 'fiscal' | 'investissement' | 'autre'
  kind              String
  currency          String           @default("EUR")
  /// Quatre derniers caractères de l'IBAN, pour reconnaître le compte. Jamais
  /// l'IBAN entier.
  iban_last4        String?
  /// Le fournisseur de synchronisation, quand il y en aura un. Null = saisie
  /// manuelle, ce qui est le seul mode existant aujourd'hui.
  provider          String?
  /// Le compte du plan comptable qui reflète ce compte bancaire. Il doit
  /// appartenir au même propriétaire — vérifié par le service.
  ledger_account_id String?          @unique @db.Uuid
  ledger_account    ledger_accounts? @relation(fields: [ledger_account_id], references: [id], onDelete: SetNull)
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)

  transactions bank_transactions[]

  @@index([owner_type, owner_id])
}

/// BANQUE — un mouvement sur un compte bancaire.
///
/// Le montant est signé ici, contrairement au journal : un relevé bancaire se
/// lit en plus et en moins, et le recopier en débit/crédit au moment de
/// l'import obligerait à interpréter avant d'avoir constaté. Le rapprochement
/// avec une écriture, lui, se fait explicitement.
model bank_transactions {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_account_id     String        @db.Uuid
  bank_account        bank_accounts @relation(fields: [bank_account_id], references: [id], onDelete: Cascade)
  /// En centimes entiers, signé : négatif pour un débit bancaire.
  amount_cents        Int
  occurred_on         DateTime      @db.Date
  label               String
  /// Référence du relevé, pour ne pas importer deux fois le même mouvement.
  external_ref        String?
  /// L'écriture comptable qui constate ce mouvement. Elle doit appartenir au
  /// même propriétaire que le compte bancaire — vérifié par le service et par
  /// une règle constitutionnelle.
  reconciled_entry_id String?       @db.Uuid
  created_at          DateTime?     @default(now()) @db.Timestamptz(6)

  @@unique([bank_account_id, external_ref])
  @@index([bank_account_id, occurred_on])
  @@index([reconciled_entry_id])
}

/// ─────────────────────────────────────────────────────────────────────────
/// INVESTISSEURS — un investisseur traverse les projets, l'argent jamais.
///
/// Ce que le produit savait déjà faire : suivre le capital d'UN projet
/// (`equity_holders`, `equity_events`), ses apports (`financing_rounds`) et
/// les dividendes versés à ses détenteurs (`dividend_distributions`). Tout
/// était rattaché à un `project_id`, et un détenteur n'était qu'un **nom** :
/// « Marie Dubois » sur le projet A et « Marie Dubois » sur le projet B
/// étaient deux lignes sans le moindre lien. Impossible, donc, de dire ce
/// qu'une personne avait investi en tout, ni ce qui lui était revenu.
///
/// Ces quatre tables ajoutent l'axe manquant — la personne — sans jamais
/// permettre à l'argent de traverser la frontière des projets :
///
///   investors            qui investit (une identité, plusieurs projets)
///   financed_projects    un projet ouvert au financement
///   participations       ce qu'un investisseur a mis dans UN projet
///   investor_movements   tout ce qui bouge, par projet ET par investisseur
///
/// La règle tenue : **aucun mouvement sans son projet et son investisseur.**
/// Les deux colonnes sont NOT NULL, donc « mouvement flottant » n'est pas un
/// état représentable. Un remboursement du projet A ne peut pas apparaître
/// dans le projet B : il faudrait pour cela écrire un mouvement dont le
/// projet et la participation se contredisent, ce qu'une règle
/// constitutionnelle refuse et qu'un audit SQL relit après coup.

/// INVESTISSEURS — l'identité d'un investisseur, indépendante des projets.
model investors {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Le compte Ignitux, quand l'investisseur en a un. Nullable : Ignitux
  /// lui-même investit, et un investisseur extérieur peut être suivi avant
  /// d'avoir un compte. Sans clé étrangère vers `users`, pour la même raison
  /// que le journal des coûts : un investissement a réellement eu lieu, et
  /// la suppression d'un compte ne doit pas effacer l'argent placé dans le
  /// projet de quelqu'un d'autre.
  user_id      String?   @db.Uuid
  /// 'personne' | 'societe' | 'ignitux'
  kind         String    @default("personne")
  display_name String
  /// Notes libres du porteur. Jamais rempli par le produit.
  note         String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  participations participations[]
  movements      investor_movements[]

  @@index([user_id])
}

/// INVESTISSEURS — un projet ouvert au financement.
///
/// Distinct de `projects` : tous les projets ne cherchent pas d'argent, et
/// celui qui en cherche a un état propre (ouvert, financé, en remboursement,
/// soldé) que le projet lui-même n'a pas à porter.
model financed_projects {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Le projet, tant qu'il existe.
  ///
  /// Nullable et détaché plutôt que cascadé, et c'est un choix de fond. Si
  /// la suppression du projet emportait le registre, un entrepreneur pourrait
  /// faire disparaître la trace de l'argent que d'autres ont mis chez lui —
  /// et la suppression de son compte échouerait de toute façon, puisque les
  /// participations refusent de partir (`Restrict`). Le registre survit donc
  /// au projet, détaché.
  project_id           String?   @unique @db.Uuid
  project              projects? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  /// Le titre recopié à l'ouverture, pour que le registre reste lisible
  /// quand le projet n'est plus là. Même principe que `client_name` sur une
  /// facture émise : ce qui est écrit à l'instant T ne bouge plus.
  project_title        String
  /// Le porteur. Passe à null à la suppression de son compte : le fait
  /// reste, l'identité part.
  entrepreneur_user_id String?   @db.Uuid
  /// Ce que le projet cherche à lever. null = pas de cible annoncée ; on
  /// n'en invente pas.
  target_cents         Int?
  /// 'ouvert' | 'finance' | 'en_remboursement' | 'solde' | 'arrete'
  status               String    @default("ouvert")
  opened_on            DateTime  @db.Date
  note                 String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @updatedAt @db.Timestamptz(6)

  participations participations[]
  movements      investor_movements[]

  @@index([entrepreneur_user_id])
  @@index([status])
}

/// INVESTISSEURS — ce qu'un investisseur a mis dans UN projet.
///
/// Pas de contrainte d'unicité sur (investisseur, projet) : on peut remettre
/// au pot. Chaque apport est sa propre participation, datée, ce qui garde
/// l'historique lisible au lieu d'écraser un montant cumulé.
model participations {
  id                         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  investor_id                String            @db.Uuid
  investor                   investors         @relation(fields: [investor_id], references: [id], onDelete: Restrict)
  financed_project_id        String            @db.Uuid
  financed_project           financed_projects @relation(fields: [financed_project_id], references: [id], onDelete: Restrict)
  invested_cents             Int
  /// La part accordée **au moment de cet apport**, en points de base.
  ///
  /// C'est un fait historique, pas l'état courant. La part d'aujourd'hui se
  /// lit dans la table de capitalisation (`equity_events`), qui reste la
  /// seule autorité sur le capital — deux sources de vérité sur un
  /// pourcentage finiraient par diverger, et la mauvaise servirait à
  /// calculer un versement. null quand l'apport ne donne pas de part
  /// (prêt, avance).
  share_basis_points_granted Int?
  /// Le détenteur correspondant dans la table de capitalisation, s'il existe.
  equity_holder_id           String?           @db.Uuid
  equity_holder              equity_holders?   @relation(fields: [equity_holder_id], references: [id], onDelete: SetNull)
  /// 'active' | 'cedee' | 'soldee'
  status                     String            @default("active")
  occurred_on                DateTime          @db.Date
  note                       String?
  created_at                 DateTime?         @default(now()) @db.Timestamptz(6)

  movements investor_movements[]

  @@index([investor_id])
  @@index([financed_project_id])
  @@index([investor_id, financed_project_id])
}

/// INVESTISSEURS — le journal immuable de tout ce qui bouge.
///
/// **Rien ne s'y supprime.** Une erreur se corrige par un mouvement de
/// correction qui désigne celui qu'il rectifie — même principe qu'un avoir
/// en facturation, et pour la même raison : un historique qu'on peut réécrire
/// ne prouve rien.
///
/// Le montant est **signé du point de vue de l'investisseur** : négatif
/// quand il verse, positif quand il reçoit. Une seule colonne, un seul sens,
/// et le portefeuille devient une somme. C'est l'inverse du choix fait pour
/// le grand livre, où débit et crédit portent le sens — là-bas une écriture
/// a deux côtés, ici un mouvement n'en a qu'un.
model investor_movements {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financed_project_id  String            @db.Uuid
  financed_project     financed_projects @relation(fields: [financed_project_id], references: [id], onDelete: Restrict)
  investor_id          String            @db.Uuid
  investor             investors         @relation(fields: [investor_id], references: [id], onDelete: Restrict)
  /// La participation concernée, quand le mouvement s'y rattache.
  participation_id     String?           @db.Uuid
  participation        participations?   @relation(fields: [participation_id], references: [id], onDelete: Restrict)
  /// 'investissement' | 'remboursement_capital' | 'dividende' | 'gain' | 'correction'
  kind                 String
  /// En centimes entiers, signé : négatif = l'investisseur verse.
  amount_cents         Int
  occurred_on          DateTime          @db.Date
  /// D'où vient ce mouvement : numéro de virement, référence de versement…
  reference            String?
  note                 String?
  /// Le mouvement que celui-ci rectifie. Renseigné uniquement sur les
  /// corrections, et seule façon d'annuler quoi que ce soit.
  corrects_movement_id String?           @db.Uuid
  /// Regroupe les mouvements nés d'une même répartition, pour qu'un
  /// versement unique reste lisible comme un seul geste.
  distribution_id      String?           @db.Uuid
  created_at           DateTime?         @default(now()) @db.Timestamptz(6)

  @@index([financed_project_id, occurred_on])
  @@index([investor_id, occurred_on])
  @@index([participation_id])
  @@index([distribution_id])
  @@index([corrects_movement_id])
}

/// RÔLES — ce qu'une personne est dans Ignitux, et qui décide de ce qu'elle voit.
///
/// Un rôle est une **vue**, jamais un conteneur. Aucune donnée ne lui
/// appartient : les projets restent à `users`, les investissements restent
/// dans `investors`/`participations`, la facturation reste où elle est.
/// C'est ce qui évite la duplication que l'on paierait autrement deux fois —
/// en stockage, puis en divergence le jour où les deux copies ne diraient
/// plus la même chose.
///
/// Conséquence voulue : retirer un rôle ne supprime rien. Cela ferme une
/// porte, cela n'efface pas une pièce.
model user_roles {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// 'entrepreneur' | 'investisseur' | 'mentor' | 'expert' | 'partenaire' | 'administrateur'
  ///
  /// Le vocabulaire vit dans le code (`roles-catalogue.ts`), pas en base :
  /// un rôle est une brique de produit, pas une donnée que l'on saisit.
  role       String
  granted_at DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([user_id, role])
  @@index([user_id])
}

/// BUREAU — les applications qu'une personne a posées sur son bureau Ignitux,
/// ou qu'elle en a retirées.
///
/// Une ligne n'existe que pour un choix explicite : sans ligne, c'est le
/// moteur d'activation qui décide (`applications/activation.ts`). En base
/// plutôt que dans le navigateur pour que le bureau soit le même sur le
/// téléphone et sur l'ordinateur.
///
/// Comme un rôle, un choix est une vue : retirer Facturation ne touche à
/// aucune facture.
model user_applications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// Identifiant du catalogue (`applications-catalogue.ts`), jamais saisi.
  app_id     String
  /// 'ajoutee' | 'retiree'
  choix      String
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([user_id, app_id])
  @@index([user_id])
}

/// PROFIL — ce qu'Ignitux sait de la personne, et pourquoi il le sait.
///
/// Colonnes explicites plutôt qu'un document JSON, et c'est un choix de
/// fond : qui lit ce schéma doit voir d'un coup d'œil quelles données
/// personnelles sont conservées. Un JSON opaque rendrait invisible ce qui
/// doit précisément rester visible — y compris pour un audit RGPD, et pour
/// moi dans six mois.
///
/// Chaque colonne correspond à un champ de `profile-fields.ts`, qui porte
/// la raison de son existence. Aucun champ ici sans usage réel : ni
/// nationalité, ni téléphone, ni adresse, ni niveau d'étude — ils ont été
/// demandés et refusés faute d'emploi (voir le catalogue).
model user_profiles {
  user_id String @id @db.Uuid
  user    users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// Comment s'adresser à la personne. Jamais déduit de l'adresse email.
  display_name       String?
  /// Décide des obligations légales affichées. La nationalité, non.
  activity_country   String?
  sectors            String[]
  experience         String?
  availability       String?
  has_founded_before String?
  motivation         String?
  skills             String[]

  investor_kind      String?
  investment_horizon String?
  risk_level         String?
  preferred_sectors  String[]

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)
}

/// L'OFFRE D'UNE PERSONNE, ET DEPUIS QUAND.
///
/// Une seule ligne par compte : on ne cumule pas deux abonnements. Ce qui
/// change au fil du temps est l'offre portée par cette ligne ; l'historique
/// de facturation vit chez le fournisseur de paiement, pas ici — le
/// dupliquer dans deux systèmes garantit qu'ils divergeront, et c'est celui
/// qui encaisse qui fait foi.
///
/// Absence de ligne = offre Découverte. C'est volontaire : personne ne doit
/// se retrouver sans offre parce qu'une écriture a échoué, et retomber sur
/// la gratuite ne prive de rien.
model subscriptions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @unique @db.Uuid
  user         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// decouverte | entrepreneur | construction — voir offres-catalogue.ts.
  /// Chaîne libre plutôt qu'enum Postgres : ajouter une offre ne doit pas
  /// demander une migration de type, et le catalogue reste l'autorité.
  offre        String
  started_on   DateTime  @db.Date
  /// Fin d'engagement. null = en cours.
  ends_on      DateTime? @db.Date
  /// Le fournisseur de paiement et la référence chez lui. null tant
  /// qu'aucun encaissement réel n'a lieu — et dans ce cas l'offre ne peut
  /// pas être payante, ce que le service vérifie.
  provider     String?
  provider_ref String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @updatedAt @db.Timestamptz(6)

  @@index([offre])
}

/// UN RELEVE DE SCORES, A UNE DATE.
///
/// Les scores sont calcules a la lecture, jamais stockes : c'est voulu, et
/// ca reste vrai. Cette table ne stocke pas LE score, elle stocke ce qu'il
/// VALAIT un jour donne — deux choses differentes. Le score du jour se
/// recalcule ; un releve d'il y a trois semaines ne se recalcule pas, parce
/// que les donnees qui l'ont produit ont change depuis.
///
/// Un seul releve par projet et par jour (@@unique). L'evolution d'un projet
/// se lit en semaines, pas en minutes : garder chaque lecture ferait des
/// milliers de lignes identiques pour une courbe qui ne dirait rien de plus.
///
/// Toutes les colonnes sont nullables, et c'est le meme principe que partout
/// ailleurs : un axe sans source vaut null, jamais zero. Une courbe qui
/// partirait de zero raconterait une progression qui n'a pas eu lieu.
model score_snapshots {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id   String    @db.Uuid
  project      projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  /// Le jour du releve, en date et non en horodatage : c'est l'unite a
  /// laquelle l'unicite a un sens.
  captured_on  DateTime  @db.Date
  etincelle    Int?
  construction Int?
  evolution    Int?
  transmission Int?
  confiance    Int?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([project_id, captured_on])
  @@index([project_id, captured_on])
}

/// IMMOBILIER — un bien, et ses mouvements (loyer perçu / charge payée),
/// même patron que stock_items/stock_movements : le solde ne s'incrémente
/// jamais à la main, il se recalcule depuis la somme des mouvements.
model real_estate_properties {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id      String    @db.Uuid
  owner         users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  project_id    String?   @db.Uuid
  project       projects? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  label         String
  address       String?
  // Solde dénormalisé (loyers perçus moins charges payées), recalculé à
  // chaque mouvement — jamais incrémenté à la main. Même principe que
  // stock_items.quantity.
  balance_cents Int       @default(0)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @updatedAt @db.Timestamptz(6)

  movements real_estate_movements[]

  @@index([owner_id])
}

model real_estate_movements {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id  String                 @db.Uuid
  property     real_estate_properties @relation(fields: [property_id], references: [id], onDelete: Cascade)
  // Signé : positif = loyer perçu, négatif = charge payée — même principe
  // que stock_movements.quantity, pas de colonne séparée pour le sens.
  amount_cents Int
  reason       String?
  occurred_on  DateTime               @db.Timestamptz(6)
  created_at   DateTime?              @default(now()) @db.Timestamptz(6)

  @@index([property_id])
}

/// VÉHICULES — une flotte, et ses dépenses d'entretien datées et relevées au
/// compteur. Le coût au kilomètre se calcule à la lecture (dépenses ÷
/// kilomètres parcourus entre deux relevés), jamais stocké : un relevé
/// modifié après coup ne doit pas laisser un coût au kilomètre périmé.
model fleet_vehicles {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id   String    @db.Uuid
  owner      users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  project_id String?   @db.Uuid
  project    projects? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  label      String
  plate      String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  entries fleet_entries[]

  @@index([owner_id])
}

model fleet_entries {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id  String         @db.Uuid
  vehicle     fleet_vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  cost_cents  Int            @default(0)
  // Le relevé au compteur ce jour-là, pas un delta depuis le dernier — un
  // delta stocké divergerait silencieusement du compteur réel au premier
  // relevé oublié.
  odometer_km Int?
  reason      String?
  occurred_on DateTime       @db.Timestamptz(6)
  created_at  DateTime?      @default(now()) @db.Timestamptz(6)

  @@index([vehicle_id])
}

/// PUBLICITÉ — une campagne, et ses dépenses/retombées datées (dépense et
/// prospects amenés, jour par jour).
model ad_campaigns {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id   String    @db.Uuid
  owner      users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  project_id String?   @db.Uuid
  project    projects? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  label      String
  channel    String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  entries ad_campaign_entries[]

  @@index([owner_id])
}

model ad_campaign_entries {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id String       @db.Uuid
  campaign    ad_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  spent_cents Int          @default(0)
  leads       Int          @default(0)
  note        String?
  occurred_on DateTime     @db.Timestamptz(6)
  created_at  DateTime?    @default(now()) @db.Timestamptz(6)

  @@index([campaign_id])
}

model identity_verifications {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                    String    @db.Uuid
  owner                       users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  document_type               String    // 'carte_identite' | 'passeport' | 'titre_sejour'
  document_front              Bytes
  document_back               Bytes?
  extracted_first_name        String?
  extracted_last_name         String?
  extracted_birth_date        DateTime? @db.Date
  extracted_document_number   String?
  extracted_expiry_date       DateTime? @db.Date
  mrz_checksum_valid          Boolean?
  name_matches_account        Boolean?
  status                      String    @default("en_attente") // 'en_attente' | 'validee' | 'rejetee'
  rejection_reason            String?
  reviewed_by                 String?   @db.Uuid
  reviewed_at                 DateTime? @db.Timestamptz(6)
  created_at                  DateTime? @default(now()) @db.Timestamptz(6)

  mandates                    mandates[]
  @@index([owner_id])
}

model mandates {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                 String                  @db.Uuid
  owner                    users                   @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  project_id               String                  @db.Uuid
  project                  projects                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  identity_verification_id String                  @db.Uuid
  identity_verification    identity_verifications  @relation(fields: [identity_verification_id], references: [id], onDelete: Restrict)
  purpose                  String
  // Nullable : un mandat existe d'abord en attente de signature (créé par
  // creerMandat), puis ces quatre champs se remplissent ensemble au moment
  // de la signature (signerMandat) — jamais partiellement. `signed_at`
  // non-null est la façon de savoir qu'un mandat est signé, sans sentinel.
  mandate_text             String?
  signed_full_name         String?
  signed_at                DateTime?               @db.Timestamptz(6)
  signer_ip                String?
  status                   String                  @default("active") // 'active' | 'revoquee'
  revoked_at               DateTime?               @db.Timestamptz(6)
  created_at               DateTime?               @default(now()) @db.Timestamptz(6)

  @@index([owner_id])
  @@index([project_id])
}

/// Dossier de création : l'état de préparation du dépôt au guichet unique,
/// une ligne par projet. Ignitux ne dépose rien : la personne coche les
/// pièces qu'elle seule peut fournir et note elle-même le dépôt.
model creation_filings {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id         String    @db.Uuid
  owner            users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  project_id       String    @unique @db.Uuid
  project          projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  status           String    @default("preparation") // 'preparation' | 'depose'
  checked_items    String[]  @default([])
  deposited_at     DateTime? @db.Timestamptz(6)
  filing_reference String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)

  @@index([owner_id])
}
