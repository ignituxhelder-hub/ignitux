generator client {
  provider = "prisma-client"
output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  password_hash String
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  projects      projects[]
  memories      memories[]
  concepts      concepts[]
  community_comments community_comments[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model projects {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id    String     @db.Uuid
  owner       users      @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Un projet public est visible dans la communauté (lecture seule pour les
  // autres utilisateurs, qui peuvent y laisser des encouragements) — false
  // par défaut, l'utilisateur décide explicitement de le rendre public.
  is_public   Boolean    @default(false)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @updatedAt @db.Timestamptz(6)
  analyses           analyses[]
  build_plans        build_plans[]
  financing_plans    financing_plans[]
  development_plans  development_plans[]
  transmission_plans transmission_plans[]
  memories           memories[]
  concepts           concepts[]
  tasks              tasks[]
  community_comments community_comments[]

  @@index([owner_id])
  @@index([is_public])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model analyses {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String    @db.Uuid
  project           projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  summary           String
  feasibility_score Int
  strengths         String[]
  risks             String[]
  next_steps        String[]
  created_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model financing_plans {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String    @db.Uuid
  project           projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  summary           String
  estimated_budget  String
  funding_sources   String[]
  budget_breakdown  String[]
  created_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model development_plans {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id     String    @db.Uuid
  project        projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  summary        String
  growth_levers  String[]
  key_metrics    String[]
  scaling_risks  String[]
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transmission_plans {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String    @db.Uuid
  project             projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  summary             String
  transfer_options    String[]
  key_documentation   String[]
  readiness_checklist String[]
  created_at          DateTime? @default(now()) @db.Timestamptz(6)

  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model memories {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project_id String?   @db.Uuid
  project    projects? @relation(fields: [project_id], references: [id], onDelete: Cascade)
  // 'decision' | 'preference' | 'learning' | 'fact' — validé au niveau DTO,
  // pas en enum Prisma (convention déjà suivie ailleurs dans ce schéma).
  category   String
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id])
  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model concepts {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  user        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project_id  String?   @db.Uuid
  project     projects? @relation(fields: [project_id], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  links_from concept_links[] @relation("concept_link_from")
  links_to   concept_links[] @relation("concept_link_to")

  @@index([user_id])
  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model concept_links {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_concept_id String    @db.Uuid
  from_concept    concepts  @relation("concept_link_from", fields: [from_concept_id], references: [id], onDelete: Cascade)
  to_concept_id   String    @db.Uuid
  to_concept      concepts  @relation("concept_link_to", fields: [to_concept_id], references: [id], onDelete: Cascade)
  relation_type   String
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([from_concept_id])
  @@index([to_concept_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tasks {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String    @db.Uuid
  project     projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  title       String
  description String?
  // 'pending' | 'in_progress' | 'done' | 'blocked'
  status      String    @default("pending")
  // 'human' | 'igini' — qui est censé agir (autonomie supervisée : IGINI
  // peut proposer/exécuter, l'humain valide toujours).
  assignee    String    @default("human")
  // D'où vient la tâche : 'analysis' | 'build_plan' | 'manual', etc.
  source      String    @default("manual")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)

  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model community_comments {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String    @db.Uuid
  project    projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  author_id  String    @db.Uuid
  author     users     @relation(fields: [author_id], references: [id], onDelete: Cascade)
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([project_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model build_plans {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String    @db.Uuid
  project             projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  summary             String
  estimated_timeline  String
  milestones          String[]
  key_resources       String[]
  created_at          DateTime? @default(now()) @db.Timestamptz(6)

  @@index([project_id])
}
